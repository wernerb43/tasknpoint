# Path to the PromptHMR model repo root (must contain the prompt_hmr Python package)
PHMR_REPO=/home/ilona/human_motion/caltennis/PromptHMR

# Conda setup — leave PHMR_CONDA_SH empty to skip activation
PHMR_CONDA_SH=/home/ilona/miniconda3/etc/profile.d/conda.sh
PHMR_CONDA_ENV=phmr_pt2.6

# Body models root — the directory that contains body_models/smplx/ and body_models/smpl/
PROMPTHMR_DATA_ROOT=/mnt/datasets/body_models

# PromptHMR pretrained models root — the directory that contains pretrain/
PROMPTHMR_PRETRAIN_ROOT=/home/ilona/human_motion/caltennis/PromptHMR/data

# Where run_prompthmr.sh saves per-video results_*.pkl chunks
RESULTS_ROOT=/mnt/datasets/robo_results/prompthmr_results

# Where extract_smpl.sh saves the retargeting .npz files
RETARGET_OUTPUTS_ROOT=/mnt/datasets/robo_results/retarget_inputs
