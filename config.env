#!/usr/bin/env bash
# Universal config for the tasknpoint repo.
# Works out of the box — no edits required.
# Override any variable by setting it in your environment before running scripts.

_CONF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

: "${PROMPTHMR_DATA_ROOT:=$_CONF_DIR/submodules/PromptHMR/data}"
: "${PROMPTHMR_PRETRAIN_ROOT:=$PROMPTHMR_DATA_ROOT}"
: "${RESULTS_ROOT:=$_CONF_DIR/video_processing/human_pose_outputs}"
: "${RETARGET_OUTPUTS_ROOT:=$_CONF_DIR/retarget}"
: "${PHMR_CONDA_ENV:=phmr_pt2.6}"

# Auto-detect conda.sh from common install locations
if [[ -z "${PHMR_CONDA_SH:-}" ]]; then
    for _c in \
        "$HOME/miniconda3/etc/profile.d/conda.sh" \
        "$HOME/anaconda3/etc/profile.d/conda.sh" \
        "/opt/conda/etc/profile.d/conda.sh" \
        "/usr/local/miniconda3/etc/profile.d/conda.sh"
    do
        if [[ -f "$_c" ]]; then PHMR_CONDA_SH="$_c"; break; fi
    done
fi
